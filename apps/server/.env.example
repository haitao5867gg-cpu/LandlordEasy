# 数据库
DATABASE_URL="mysql://landlord:landlord123@localhost:3306/landlord_easy"

# 服务端口
PORT=3000

# JWT
JWT_SECRET="your-jwt-secret-change-in-production"
JWT_EXPIRES_IN="7d"

# 微信模式: mock | real
WECHAT_MODE="mock"

# 微信配置(real 模式下使用)
WECHAT_APPID="your-appid"
WECHAT_SECRET="your-appsecret"
WECHAT_TEMPLATE_RENT_REMINDER="your-template-id"
# 电子签约"签署完成"模板消息(不受客服消息48小时互动窗口限制,跟客服消息并行发送作保底)。
# 模板字段:thing1=房屋地址/character_string2=合同编号/const3=合同类型/time4=合同期/thing5=签约人
WECHAT_TEMPLATE_CONTRACT_SIGNED="your-template-id"
# 微信公众平台"服务器配置"里填写的Token,必须跟这里的值完全一致(用于URL接入验证和事件推送)。
# 消息加密方式在公众平台后台要选"明文模式"——当前代码未实现"安全模式"的AES解密。
WECHAT_TOKEN="your-token"

# 在线支付模式: mock | real（未设置时默认为 mock）
PAYMENT_MODE="mock"

# 在线支付回调公网根地址(real 模式下使用，例如 https://api.example.com)
PAYMENT_NOTIFY_BASE_URL=""

# 微信支付 V3 配置(real 模式下使用；私钥支持 PEM 内容或文件路径)
WECHAT_PAY_MCH_ID=""
WECHAT_PAY_APIV3_KEY=""
WECHAT_PAY_SERIAL_NO=""
WECHAT_PAY_PRIVATE_KEY=""

# 支付宝功能开放开关:只有字符串 "true" 才启用；未设置或任何其他值都视为未开放。
# 此开关只控制功能是否可用，mock/real 实现模式仍由 ALIPAY_MODE（或 PAYMENT_MODE 回退值）控制。
ALIPAY_ENABLED=false

# 支付宝配置(real 模式下使用；密钥支持 PEM 内容或文件路径)
ALIPAY_APP_ID=""
ALIPAY_PRIVATE_KEY=""
ALIPAY_PUBLIC_KEY=""

# 备案审核演示登录:默认关闭,仅需临时向审核人员开放时手动设为 true
PUBLIC_REVIEW_MODE=false

# 腾讯电子签模式: mock | real（未设置时默认为 mock）
ESIGN_MODE="mock"

# 腾讯电子签 Essbasic 配置（real 模式下使用）
TENCENT_ESIGN_TEMPLATE_ID=""
TENCENT_ESIGN_APP_ID=""
TENCENT_ESIGN_PROXY_ORGANIZATION_OPEN_ID=""
TENCENT_ESIGN_PROXY_OPERATOR_OPEN_ID=""
TENCENT_ESIGN_TENANT_RECIPIENT_ID=""
TENCENT_ESIGN_SECRET_ID=""
TENCENT_ESIGN_SECRET_KEY=""

# 第三方应用回调配置（控制台未启用对应能力时可留空）
TENCENT_ESIGN_CALLBACK_VERIFY_TOKEN=""
TENCENT_ESIGN_CALLBACK_ENCRYPT_KEY=""
# 微签模式: mock | real（未设置时默认为 mock）
WEIQIAN_MODE="mock"

# 微签 SAAS Web API 配置（real 模式下使用）
WEIQIAN_APP_ID=""
WEIQIAN_APP_SECRET=""
WEIQIAN_COMPANY_ID=""
WEIQIAN_SEAL_ID=""
WEIQIAN_API_BASE_URL=""

# 本服务公网 API 根地址,用于微签签署完成后的浏览器回跳
# 生产环境应配置为 https://landlordeasy.cn/api/v1
SERVER_PUBLIC_BASE_URL=""

# 微签租客签署页根地址;当前默认使用文档中的测试环境
# 正式环境地址尚待微签确认,确认后请替换此值
WEIQIAN_SIGN_BASE_URL="http://forwave.picp.net:8888"

# 合同PDF生成用的Chrome/Chromium可执行文件路径(puppeteer-core不自带下载)
# 本地Mac默认会自动找/Applications/Google Chrome.app,一般不用配;
# 生产服务器(Ubuntu 24.04)必须显式配置,步骤(2026-09-01在dev环境验证过,不要用
# `apt install chromium-browser`,那是指向snap的过渡包):
#   1. cd /tmp && npm init -y && npm install @puppeteer/browsers
#      ./node_modules/.bin/browsers install chrome@stable --path ~/chrome-for-testing
#   2. sudo apt-get install -y libatk1.0-0t64 libatk-bridge2.0-0t64 libcups2t64 \
#        libasound2t64 libgbm1 libcairo2 libpango-1.0-0 libxcomposite1 libxdamage1 \
#        libxfixes3 libxrandr2 libatspi2.0-0t64
#   3. 把下载出来的chrome可执行文件完整路径填进这里
PDF_CHROME_EXECUTABLE_PATH=""
